#let emptyLine = v(leading) // Просто пустая строка.

// Заголовки
#set heading(
  supplement: none,
  numbering: (..numbers) => {
    let n = numbers.pos()
    if n.len() == 1 {
      numbering("1", ..n)
    } else if n.len() == 2 {
      numbering("1.1", ..n)
    } else {
      numbering("1.1.1", ..n)
    }
  }
)

#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  v(1em)
  align(center, text(weight: "bold", it))
  v(1em)
}

#show heading.where(level: 2): it => {
  v(1em)
  align(center, text(weight: "bold", it))
  v(2em)
}

#let numberlessHeader(title) = {
  pagebreak(weak: true)
  heading(level: 1, numbering: none, title)
}

// Списки
#let section-counter = counter("section")

#let startList() = {
  section-counter.update(0)
}
#let increment(level) = {
  parbreak()
  section-counter.step(level: level)
  context section-counter.display("1.1.1")
  [.]
}
#let mark = [
  #parbreak()
  •
]

// Рисунки
#set figure(
  supplement: "Рисунок",
  numbering: (..numbers) => {
    let n = numbers.pos()
    let section = counter(heading.where(level: 1)).get().first()
    if n.len() >= 1 {
      numbering("1.1", section, n.at(0))
    } else {
      numbering("1", section)
    }
  },
)

#show figure.where(kind: image): set figure.caption(position: bottom, separator: [ – ])

#show figure.caption: it => {
  set align(center)
  set par(
    leading: 1em,
    first-line-indent: (amount: 0pt, all: true),
    justify: false,
  )
  it
  emptyLine
}

#show figure.where(kind: image): it => {
  set align(center)
  set par(first-line-indent: 0pt)
  it
}

#show ref: it => {
  if it.element == none {
    it
  } else if it.element.func() == figure {
    link(it.target, {
      let full = it
      show it.element.caption.at("supplement").text: none
      full
    })
  } else {
    it
  }
}

// Формулы
#set math.equation(numbering: (..numbers) => {
  let section = counter(heading.where(level: 1)).get().first()
  numbering("(1.1)", section, ..numbers)
})
#set math.equation(supplement: none)

