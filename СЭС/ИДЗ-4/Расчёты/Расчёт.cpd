#def R_p$(R_1$; R_2$) = (1/(1/(R_1$) + 1/(R_2$)))
#def C$(f$;R$) = 1/(2*π*f$*(R$))
dB(x) = 20*log(abs(x))

#Show
" ИДЗ-4: Проектирование линейного усилителя на ОУ

" Дано
' Для варианта 5:

K_u = 7000
f_н = 0.1кГц|кГц
f_в = 20кГц|кГц
E_ип = 15В|В
R_вх_мин = 500кОм

' Тестовый импульсный сигнал
t_и = 500мкс|мкс
Q = 100
T = Q * t_и | мс

" Расчёт усилителя

' Неизвестна частота единичного усиления операционного усилителя. Для практических расчётов был взят ОУ LF347-N, который имеет следующие характеристики:
f_01 = 4МГц|МГц
' Тогда коэффициент усиления одного каскада не должен превышать
K_u_каскада_max = f_01 / f_в
'Пусть будет двухкаскадная схема с ' K_u1 = 100 ' тогда'
K_u2 = K_u / K_u1

'Сопротивления двух неинвертирующих усилителей'
R_b1 = 10кОм|кОм
R_t1 = (K_u1-1)*R_b1|кОм
R_b2 = 10кОм|кОм
R_t2 = (K_u2-1)*R_b2|кОм
' Частота ограничена сверху ' f_в ', необходима корректировка верхней граничной частоты.
С_2 = C$(f_в; R_t1) | пФ

' Т.к. задано ' f_н ', то чтобы напряжение смещения не влияло на схему, можно избавиться от постоянной составляющей усилителя.
R_hpf1 = 100кОм|кОм
C_hpf1 = C$(f_н; R_hpf1) | нФ

" Предварительные расчёты для моделирования и проверки
U_m_вых = E_ип - 1.5В|В
U_m_вх = U_m_вых / K_u | мВ
dB(K_u)
dB(K_u1)
dB(K_u2)

dBK_u_моделирования = 76.8
K_u_моделирования = 10^(dBK_u_моделирования/20)
ΔK_u = abs(K_u_моделирования - K_u)
δK_u = ΔK_u/K_u | %

K_u_моделирования
ΔK_u
δK_u

" 2. Снять АЧХ усилителя. Определить нижнюю и верхнюю граничные частоты.
f_моделирования_н = 98.8Гц|Гц
f_моделирования_в = 19.6кГц|кГц

Δf_н = abs(f_моделирования_н - f_н) | кГц
δf_н = Δf_н/f_н | %
Δf_в = abs(f_моделирования_в - f_в) | кГц
δf_в = Δf_в/f_в | %

f_моделирования_н
f_моделирования_в
