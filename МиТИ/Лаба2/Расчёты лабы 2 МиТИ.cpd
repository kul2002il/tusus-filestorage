'<style> .eq var,i {color: black !important;}</style>
'<style> .nary {color: black !important;}</style>


#Hide

#Round 3
.мс = 1ms
.с = 1s

.Ом = 1Ω
.кОм = 1kΩ

.пФ = 1pF
.нФ = 1nF
.мкФ = 1μF
.Ф = 1F

.мкГн = 1μH
.мГн = 1mH

.мВ = 1mV
.В = 1V

.мА = 1mA

.Гц = 1Hz
.кГц = 1kHz
.МГц = 1MHz

"Правила округления"
x = 53333пФ|пФ
Δx = 1.111нФ|нФ

RoundX(x; Δx) = round(x / 10^floor(log(Δx / getunits(Δx)) - log(4)) ) * 10^floor(log(Δx / getunits(Δx)) - log(4))
RoundΔ(Δx) = RoundX(Δx; Δx)

#def result$(x$; Dx$; measure$) = '(' RoundX(x$; Dx$)|measure$ '±' RoundΔ(Dx$)|measure$ ')'

#val
'X = ' result$(x; Δx; пФ) 'пФ
#equ

#Show





"6.1. Измерить индуктивность катушки методом непосредственного отсчета прибором Е9-4 (Е4-4) на одной из частот, указанных на передней панели. Оценить точность измерения.

f_изм = 2.4МГц|кГц ' — частота измерений
L_изм_Е4_4 = 74мкГн|мкГн ' — измеренное значение

C_изм = 60пФ|пФ ' — ёмкость, показанная прибором при измерении

'На основании технических данных куметра Е4-4
ΔC_Е4_4(C_изм) = if(C_изм < 100пФ; 1пФ; C_изм*1%)
'Погрешность измеренной ёмкости составляет:
ΔC_изм = ΔC_Е4_4(C_изм)|пФ
δC_изм = ΔC_изм/C_изм|%

'На основании частотомера Ч3-44
δ_кв = 10^-5 ' — измерения снимались через 15 минут самопрогрева
t_сч = 100мс|мс ' — время счёта
δf_изм = δ_кв + 1/(f_изм*t_сч)|%

'По методичке
δL_изм_Е4_4 = sqrt(δC_изм^2 + (2*δf_изм)^2)|%

ΔL_изм_Е4_4 = δL_изм_Е4_4*L_изм_Е4_4
#Val
'L = ' result$(L_изм_Е4_4; ΔL_изм_Е4_4; мкГн) 'мкГн'
#Equ




" Измерить индуктивность катушки косвенным методом на различных частотах, равномерно устанавливая значения емкости кондесатора куметра во всем диапазоне от 25пФ до 450пФ (не менее 15 измерений).
' извлечение данных из таблицы
#read measured from Измерения.csv
C=col(measured;1)*пФ|пФ
f=col(measured;2)*кГц|кГц
n=n_rows(measured)

' Расчёт всех значений индуктивностей
' Пример расчёта одного значения
L_1 = 1/(4*π^2*f.1^2*C.1)|мкГн

' Расчёт всех значений индуктивностей
L_i = 1/(4*π^2*f^2*C)|мкГн

#def C_0$(i$;j$)
#hide
f_i$ = f.i$|кГц
f_j$ = f.j$|кГц
C_i$ = C.i$|пФ
C_j$ = C.j$|пФ
#show
C_0_i$_j$ = (C_i$ - C_j$ * (f_j$ /f_i$ )^2) / ((f_j$ /f_i$ )^2 - 1)|пФ
#end def

C_0$(1;5)
C_0$(5;13)
C_0$(13;18)

C_0 = (C_0_1_5 + C_0_5_13 + C_0_13_18) / 3|пФ


' Расчёт всех значений индуктивностей, свободных от систематической погрешности
' Пример расчёта одного значения
L_01 = L_1*(C.1/(C.1+C_0))|мкГн

' Расчёт всех значений индуктивностей
L_0i = L_i*(C/(C+C_0))|мкГн

' Данные для таблицы 8.1
#val
'<table border="1px" style="border-collapse: collapse; text-align: center;">'
'  <tr>'
'    <th>С, пФ</th>'
'    <th>f, кГц</th>'
'    <th>L_i, мкГн</th>'
'    <th>L_0i, мкГн</th>'
'  </tr>'
#for i = 1 : n
'  <tr>'
'    <td>' C.i |пФ '</td>'
'    <td>' f.i |кГц '</td>'
'    <td>' L_i.i  |мкГн '</td>'
'    <td>' L_0i.i |мкГн '</td>'
'  </tr>'
#loop
'</table>'
#equ

' Рассчитали среднее арифметическое
L_ср = average(L_0i)|мкГн

' Вычисляется оценка среднеквадратического отклонения результата измерения S_Lср от истинного значения измеряемой величины (среднеквадратическое отклонение среднего)

' Промежуточный расчёт нужно вырезать, а то это дичь какая-то
S_Lср = sqrt( $Sum{ (L_0i.i - L_ср)^2 @ i = 1 : n} / (n*(n-1)) ) |мкГн


" Определяем коэффициент Стьюдента по таблице
' <img alt="Таблица не в файле. Не загрузилось — я не виноват." src="http://fevt.ru/_ld/8/32164894.png">

'Пусть ' P_д = 0.9 ' тогда для ' n ' будет ' t_a = 1.7 '.'

ΔL_д = t_a * S_Lср | мкГн

#Val
'L = ' result$(L_ср; ΔL_д; мкГн) 'мкГн'
#Equ

" 6.3. По результатам п. 6.2 вычислить собственную емкость катушки индуктивности (не менее трех вычислений, используя наиболее отличающиеся по величине значения частот) и найти среднее значение.

' Вычислено выше

" 6.4. Измерить емкости конденсаторов (малой и большой емкости) прибором Е9-4 (Е4-4). Оценить точность измерения.

' Измерение малой ёмкости:

C_1 = 450пФ|пФ
C_2 = 330пФ|пФ

C_м_E4_4 = C_1 - C_2 |пФ

ΔC_1 = ΔC_Е4_4(C_1)|пФ
ΔC_2 = ΔC_Е4_4(C_2)|пФ

δC_м_E4_4 = sqrt((ΔC_1/(C_1-C_2))^2+(ΔC_2/(C_1-C_2))^2)|%

ΔC_м_E4_4 = δC_м_E4_4 * C_м_E4_4|пФ

#Val
'C_малое = ' result$(C_м_E4_4; ΔC_м_E4_4; пФ) 'пФ'
#Equ


' Измерение большой ёмкости

C_1=200пФ|пФ
C_2=244пФ|пФ

ΔC_1 = ΔC_Е4_4(C_1)|пФ
ΔC_2 = ΔC_Е4_4(C_2)|пФ

C_б_E4_4=1/(1/C_1-1/C_2)|пФ

δC_б_E4_4=sqrt((C_2/(C_1-C_2)*(ΔC_1/C_1))^2+(C_1/(C_1-C_2)*(ΔC_2/C_2))^2)|%

ΔC_б_E4_4 = δC_б_E4_4 * C_б_E4_4|пФ

#Val
'C_большое = ' result$(C_б_E4_4; ΔC_б_E4_4; пФ) 'пФ'
#Equ


" 6.5. Измерить индуктивность катушки и емкостей конденсаторов методом сравнения с мерой на приборе Е12-1 (Е12-1А). Оценить точность измерения.

#def dC$(C$)=0.005*C$ +0.4пФ|пФ

C_м_Е12_1=129.96пФ|пФ
ΔC_м_Е12_1 = dC$(C_м_Е12_1)
#Val
'C_м_Е12_1 = ' result$(C_м_Е12_1; ΔC_м_Е12_1; пФ) 'пФ'
#Equ

C_б_Е12_1=1033.32пФ|пФ
ΔC_б_Е12_1 = dC$(C_б_Е12_1)
#Val
'C_б_Е12_1 = ' result$(C_б_Е12_1; ΔC_б_Е12_1; пФ) 'пФ'
#Equ


L_Е12_1=70.9038мкГн|мкГн
ΔL_Е12_1=0.015*L_Е12_1+2*0.1мкГн|мкГн
#Val
'L_Е12_1 = ' result$(L_Е12_1; ΔL_Е12_1; мкГн) 'мкГн'
#Equ


" 6.6. Измерить индуктивность катушки и емкостей конденсаторов на приборе Е7-21. Оценить точность измерения.


' У нас был AM-3125
' Не помню на какой частоте измеряли. Допустим 10 кГц.

' Диапазон 400 пФ
C_м_AM_3125=129.9пФ|пФ
ΔC_м_AM_3125=0.0035*C_м_AM_3125+0.03нФ|пФ
#Val
'C_м_AM_3125= ' result$(C_м_AM_3125; ΔC_м_AM_3125; пФ) 'пФ'
#Equ

' Диапазон 4 нФ
C_б_AM_3125=1031.1пФ|пФ
ΔC_б_AM_3125=0.0025*C_б_AM_3125+0.0002нФ|пФ
#Val
'C_б_AM_3125= ' result$(C_б_AM_3125; ΔC_б_AM_3125; пФ) 'пФ'
#Equ

' Диапазон 400 мкГн
L_AM_3125=71мкГн|мкГн
ΔL_AM_3125=0.0045*L_AM_3125+0.02мкГн|мкГн
#Val
'L_AM_3125 = ' result$(L_AM_3125; ΔL_AM_3125; мкГн) 'мкГн'
#Equ


