#def R_p$(R_1$; R_2$) = (1/(1/(R_1$) + 1/(R_2$)))
#def C$(f$;R$) = 1/(2*π*(f$)*(R$))
dB(x) = 20*log(abs(x))

#Show



'Вектор значений Y (для X = 1, 2, 3, 4, 5)
Y = [2; 5; 3; 8; 6]

'Построение ломаной (линейная интерполяция)
$Plot{line(x; Y) @ x = 1 : 5}

'Построение плавной кривой (сплайн Эрмита)
$Plot{spline(x; Y) @ x = 1 : 5}



'Координаты точек
X = [0; 1.5; 4; 4.2; 7]
Y = [1; 4; 2; 6; 5]
n = len(X)

'Параметрический график (t играет роль индекса точки от 1 до n)
$Plot{line(t; X) | line(t; Y) @ t = 1 : n}



'=== Наложение двух сигналов напряжения ===
'Временная ось (условные моменты времени)
X1 = [0; 1; 2; 3; 4; 5]
X2 = [0; 1.5; 2.5; 3; 4; 5]

'Сигнал 1 (например, прямоугольная волна)
V1 = [0; 5; 5; 0; 0; 5]

'Сигнал 2 (например, треугольная волна)
V2 = [1; 3; 1; 3; 1; 3]

'Количество точек
n = len(X1)

'Построение двух параметрических кривых на одном графике с помощью &

lineLine(t; min; max) = min * (1-t) + max * t

$Plot{
    line(t; X1)|line(t; V1) &
    line(t; X2)|line(t; V2) + 5 &
    2 | lineLine((t-1)/(n-1); 0; 8) @
    t = 1 : n}


























" Анализ
' <img src="img/схема с диодами в интеграторе.png" alt="схема с диодами в интеграторе"/>

#Noc

' Напряжения входа представлены только двумя уровнями с учётом падения напряжения на диодах:
U_Dint1 '=' U_Dint2 = 0.7В ';
U_int_in_max = VCC ' = ' E_ип - U_Dint1 ';
U_int_in_min = VEE ' = ' -E_ип + U_Dint2 '.
' Напряжения выхода ограничены напряжением срабатывания триггера
U_int_out_max = E_ип - U_запас_нелинейных_искажений
U_int_out_min = -U_int_out_max
' Напряжение на интеграторе изменяется линейно
U_int_out(Δt) = U_0 - U_int_in * Δt / (C*R) '⇒
U_int_in * Δt / (C*R) = U_0 - U_int_out(Δt) '⇒
Δt = (U_0 - U_int_out(Δt)) * C * R / U_int_in '.
' Напряжение изменяется от U_int_out_min до U_int_out_max и обратно, следовательно
U_0 - U_int_out(t_int_down) ' = ' U_int_out_min - U_int_out_max ' = ' -2 * U_int_out_max ' для ' U_int_in < 0 ';
U_0 - U_int_out(t_int_up) ' = ' U_int_out_max - U_int_out_min ' = ' 2 * U_int_out_max ' для ' U_int_in > 0 '.

' Период сигнала c учетом падения на диодах составляет:
T = t_int_down + t_int_up '='
'=' (-2 * U_int_out_max) * C * R_int1 / (U_int_in_min) + (2 * U_int_out_max) * C * R_int2 / U_int_in_max '='
'=' 2*C * (-U_int_out_max * R_int1 / U_int_in_min + U_int_out_max * R_int2 / U_int_in_max) '=
'= {' U_int_in_min = - U_int_in_max'} ='
'=' 2*C * (-U_int_out_max * R_int1 / (-U_int_in_max) + U_int_out_max * R_int2 / U_int_in_max) '='
'=' 2*C * U_int_out_max / U_int_in_max * (R_int1 + R_int2) '.
' Данная схема позволяет независимо регулировать период сигнала и скважность.

#Equ








" Расчеты курсовой

" Задано
' Коэффициент заполнения:
α_min = 0.1
α_max = 0.9

' Период сигнала:
T_min = 50мкс|мкс
T_max = 0.5с|с
' Это в частотах
f_max = 1/T_min|кГц
f_min = 1/T_max|Гц

' Регулировка амплитуды импульсов
U_out_ac_max = 10В|В
' Регулировка постоянной составляющей
U_out_dc_min = -10В|В
U_out_dc_max = 10В|В

' Пусть питание
E = 12В|В


" Расчёт триггера

'Пусть:'
R_1 = 10кОм|кОм
U_запас_нелинейных_искажений = 1.5В|В

' Расчеты
U_гистерезиса = E - U_запас_нелинейных_искажений |В
#noc
U_гистерезиса = E * (R_1/R_2) ' => '
#equ
' => ' R_2 = R_1 * (E/U_гистерезиса)|кОм

" Расчёт интегратора

#noc
U_интегратора(Δt) = U_0 - U_входа * Δt / (C*R)
U_входа * Δt / (C*R) = U_0 - U_интегратора(Δt) '=' 2 * U_гистерезиса
Δt = 2 * U_гистерезиса * C * R / abs(U_входа)
' Если изменение времени увеличения и уменьшения напряжения интегратора делать при помощи резистора и двух диодов на входе, то будут следующие проблемы:

' Если разность
T = Δt_увеличение + Δt_уменьшение '='
2 * U_гистерезиса * C * R / abs(U_входа_положительное) + 2 * U_гистерезиса * C * R / abs(U_входа_отрицательное)
2 * U_гистерезиса * C * R * (1 / abs(U_входа_положительное) + 1 / abs(U_входа_отрицательное))
#equ


" Расчёт несимметричного делителя

'Пусть:'
RV_1 = 10кОм|кОм