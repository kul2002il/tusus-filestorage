'<style> body { max-width: initial } </style>
#Hide

#Round 3
.Ом = 1Ω
.кОм = 1kΩ
.нФ = 1nF
.мкФ = 1μF
.В = 1V
.мВ = 1mV
.мА = 1mA
.Гц = 1Hz

#Show
' Исходная схема

'<img src="Схема новая.png" alt="Новая схема">
dB(x) = 20*log(abs(x))

' Дано
E_source = 12В|В
β = 150
U_be0 = 0.7В|В

U_b1 = 2.5В|В
I_e1 = 2мА

R_c2 = 3.523кОм|кОм
U_ce2 = 0.5*E_source|В
U_Rc2 = 0.4*E_source|В
U_Re2 = 0.1*E_source|В

f_н = 600Гц|Гц
U_sign = 50мВ|мВ
R_sign = 0.4кОм|кОм
R_load = 10кОм|кОм

#def R_p$(R_1$; R_2$) = (1/(1/(R_1$) + 1/(R_2$)))
#def r_be$(I_e$) = 30мВ*β/(I_e$)

" Расчёт по постоянному току

' Первый каскад
U_e1 = U_b1 - U_be0|В
R_b1 = (E_source - U_b1)/(I_e1*(1/(1 + β)))|кОм
R_e1 = U_e1/I_e1|кОм

' Второй каскад
I_e2 = (1+β)/β * (U_Rc2 / R_c2)|мА
U_b2 = U_Re2 + U_be0|В
R_b2 = (E_source - U_b2)/(I_e2*(1/(1 + β)))|кОм
R_e2 = U_Re2/I_e2|кОм

" Расчёт по переменному току
r_be1 = r_be$(I_e1)|кОм
r_be2 = r_be$(I_e2)|кОм

R_c_экв = R_p$(R_c2; R_load)|кОм

' Вывод R_et2

k_зап = 0.9
K_u2 = - (k_зап * (U_ce2/2) / U_sign)

#Noc
K_u2 = -β*R_c_экв/(r_be2 + (1+β)*R_et2)
r_be2 + (1+β)*R_et2 '=' -β*R_c_экв/K_u2
(1+β)*R_et2 '=' -β*R_c_экв/K_u2 - r_be2
#Equ
R_et2 = (-β*R_c_экв/K_u2 - r_be2)/(1+β)|Ом

R_eb2 = R_e2 - R_et2|кОм

' Входные и выходные сопротивления

R_in2 = R_p$(R_b2; r_be2 + (1+β)*R_et2)|кОм
R_e1экв = R_p$(R_e1; R_in2)|кОм
R_in1 = R_p$(R_b1; (r_be1 + (1 + β)*R_e1экв))|кОм
R_b1экв = R_p$(R_b1; R_sign)|кОм
R_out1 = R_p$(R_e1; (r_be1 + R_b1экв)*(1/(1 + β)))|кОм

' Расчёт конденсаторов
n = 4
#def C$(R$) = sqrt(n)/(2*π*f_н*(R$))
C_1 = C$(R_sign + R_in1)|нФ
C_2 = C$(R_out1 + R_in2)|нФ
C_3 = C$(R_c2 + R_load)|нФ
R_e2параллельное = (1/(1 + β)) * (r_be2 + R_p$(R_b2; R_out1))|кОм
C_e2 = C$(R_p$(R_eb2; R_et2 + R_e2параллельное))|мкФ

' Расчёт коэффициента усиления по напряжению
K_ud = R_in1/(R_in1 + R_sign)
K_u1 = 1/(r_be1/((1 + β)*R_e1экв) + 1)
R_c_экв = R_p$(R_c2; R_load)|кОм
K_u = K_ud*K_u1*K_u2
dB(K_u)


' Данные для моделирования:
R_sign|кОм
R_b1|кОм
R_e1|кОм
R_b2|кОм
R_c2|кОм
R_et2|Ом
R_eb2|кОм
R_load|кОм

C_1|нФ
C_2|нФ
C_3|нФ
C_e2|мкФ

' Рабочая точка
U_b1|В
U_c1=E_source|В
U_e1|В
U_b2|В
U_c2=E_source-U_Rc2|В
U_e2=U_Re2|В


' Результаты моделирования

U_pp_out = -2.85В - 2.37В|В

K_u_моделирования = (U_pp_out / (2*U_sign))
dB(K_u_моделирования)

' Отклонение от расчётного

ΔK_u = abs(K_u - K_u_моделирования)
δK_u = ΔK_u / abs(K_u)|%

' Заключение

K_u
K_u_моделирования
ΔK_u
δK_u
