#def R_p$(R_1$; R_2$) = (1/(1/(R_1$) + 1/(R_2$)))
#def C$(f$;R$) = 1/(2*π*(f$)*(R$))
dB(x) = 20*log(abs(x))

#Show
" Анализ
' <img src="img/схема с диодами в интеграторе.png" alt="схема с диодами в интеграторе"/>

#Noc

' Напряжения входа представлены только двумя уровнями:
U_int_in_max = VCC ' = ' E_ип
U_int_in_min = VEE ' = ' -E_ип
' Напряжения выхода ограничены напряжением срабатывания триггера
U_int_out_max = E_ип - U_запас_нелинейных_искажений
U_int_out_min = -U_int_out_max
' Напряжение на интеграторе изменяется линейно
U_int_out(Δt) = U_0 - U_int_in * Δt / (C*R)
U_int_in * Δt / (C*R) = U_0 - U_int_out(Δt)
Δt = (U_0 - U_int_out(Δt)) * C * R / U_int_in
' Напряжение изменяется от U_int_out_min до U_int_out_max и обратно, следовательно
U_0 - U_int_out(t_int_down) ' = ' U_int_out_min - U_int_out_max ' = ' -2 * U_int_out_max ' для ' U_int_in > 0
U_0 - U_int_out(t_int_up) ' = ' U_int_out_max - U_int_out_min ' = ' 2 * U_int_out_max ' для ' U_int_in < 0
' Период сигнала составляет:
T = t_int_down + t_int_up '='
(-2 * U_int_out_max) * C * R / U_int_in_max + (2 * U_int_out_max) * C * R / U_int_in_min

#Equ








" Расчеты курсовой

" Задано
' Коэффициент заполнения:
α_min = 0.1
α_max = 0.9

' Период сигнала:
T_min = 50мкс|мкс
T_max = 0.5с|с
' Это в частотах
f_max = 1/T_min|кГц
f_min = 1/T_max|Гц

' Регулировка амплитуды импульсов
U_out_ac_max = 10В|В
' Регулировка постоянной составляющей
U_out_dc_min = -10В|В
U_out_dc_max = 10В|В

' Пусть питание
E = 12В|В


" Расчёт триггера

'Пусть:'
R_1 = 10кОм|кОм
U_запас_нелинейных_искажений = 1.5В|В

' Расчеты
U_гистерезиса = E - U_запас_нелинейных_искажений |В
#noc
U_гистерезиса = E * (R_1/R_2) ' => '
#equ
' => ' R_2 = R_1 * (E/U_гистерезиса)|кОм

" Расчёт интегратора

#noc
U_интегратора(Δt) = U_0 - U_входа * Δt / (C*R)
U_входа * Δt / (C*R) = U_0 - U_интегратора(Δt) '=' 2 * U_гистерезиса
Δt = 2 * U_гистерезиса * C * R / abs(U_входа)
' Если изменение времени увеличения и уменьшения напряжения интегратора делать при помощи резистора и двух диодов на входе, то будут следующие проблемы:

' Если разность
T = Δt_увеличение + Δt_уменьшение '='
2 * U_гистерезиса * C * R / abs(U_входа_положительное) + 2 * U_гистерезиса * C * R / abs(U_входа_отрицательное)
2 * U_гистерезиса * C * R * (1 / abs(U_входа_положительное) + 1 / abs(U_входа_отрицательное))
#equ


" Расчёт несимметричного делителя

'Пусть:'
RV_1 = 10кОм|кОм