" ИДЗ-4: Проектирование линейного усилителя на ОУ

' Исходная схема

dB(x) = 20*log(abs(x))

" Дано
' Для варианта 5:

K_u = 7000
f_н = 0.1кГц|кГц
f_в = 20кГц|кГц
E_ип = 15В|В
R_вх_мин = 500кОм

' Тестовый импульсный сигнал
t_и = 500мкс|мкс
Q = 100
T = Q * t_и | мс

" Предварительные расчёты для моделирования
U_m_вых = E_ип - 1.5В|В
U_m_вх = U_m_вых / K_u | мВ
'Пусть будет двухкаскадная схема с ' K_u1 = 100 ' тогда'
K_u2 = K_u / K_u1

'Сопротивления двух неинвертирующих усилителей'
R_2 = 10кОм|кОм
R_1 = (K_u1-1)*R_2|кОм
R_4 = 10кОм|кОм
R_3 = (K_u2-1)*R_4|кОм


" 3.
t_ф = 1мс

f_в_моделирования = 0.35/t_ф | кГц
f_н_моделирования = ln(U_m_вых_нач/U_m_вых_кон) / 2 * π * t_и

D = U_m_вых_нач/t_ф |В/с


